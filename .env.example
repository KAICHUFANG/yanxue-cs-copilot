# 复制本文件为 .env，填入自己的 Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# 可选
TEMPERATURE=0.3
MAX_TOOL_ROUNDS=6

# 进校预约提醒里的「被访人」（老师）信息。会直接进发给家长的文案，属个人信息。
# **唯一存储位置就是这里（.env）**：.env 在 .gitignore 里，不进仓库、不进 GitHub。
# 在对话框里说「被访人姓名是 xxx / 被访人电话是 xxx」也会写回这两行。
VISIT_TARGET_NAME=某某老师
VISIT_TARGET_PHONE=13800000000

# 使用记录里记成谁（本机使用者）。留空就记成「未署名」
CHAT_LOG_OPERATOR=小陈
