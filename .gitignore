# ---- 密钥（绝对不能进版本库）----
.env
.env.*
!.env.example

# ---- Python 缓存 ----
__pycache__/
*.py[cod]

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- 运行产物 ----
*.log
logs/
outputs/
data/backups/

# ---- 评测产物（可重新生成，不进仓库）----
eval/tmp_*
eval/report.json
eval/backups/

# ---- IDE / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
# ---- 使用记录（含家长问句，不进仓库）----
data/logs/

# ---- 个人信息（老师姓名/电话），绝不能进仓库 ----
data/team_info.local.json
